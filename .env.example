APP_NAME=VideTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# In production LOG_CHANNEL=stderr: visible in `docker logs`, no growing file.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sessions live in files by default (off the domain SQLite file's write
# lock) and last 30 days of inactivity.
# SESSION_LIFETIME=43200
# Unset, the session cookie is HTTPS-only exactly when APP_URL is https://.
# SESSION_SECURE_COOKIE=
# Whose X-Forwarded-* headers to trust; by default proxies on private
# addresses. "*" is safe only when nothing but the reverse proxy reaches the app.
# TRUSTED_PROXIES=PRIVATE_SUBNETS

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file avoids cache writes contending on the domain SQLite write lock.
CACHE_STORE=file
# CACHE_PREFIX=

# Mail sends the password-reset link; with "log" it only reaches the log.
MAIL_MAILER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=videtrack@localhost

VITE_APP_NAME="${APP_NAME}"

# Tracker
# Unset: sign-up is open until the first account exists (it becomes the
# administrator), then closed.
REGISTRATION_ENABLED=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signing in through identity providers (docs/install.md). Each one is told
# the callback ${APP_URL}/auth/<oidc|google|github|gitlab>/callback.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_URL=https://gitlab.com
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# PASSWORD_LOGIN_ENABLED=true
# The MCP server for AI assistants at /api/mcp (docs/api.md).
# MCP_ENABLED=true
# The instance's language (en / pl); each user can pick their own.
DEFAULT_LOCALE=en
# Shown on About; set by the image build to the release tag.
# APP_VERSION=dev

# Scrobbling: how much of a title a media server must report before a stop
# counts as watched, the window in which two servers' reports of one viewing
# make one play, and how long the delivery log is kept.
# SCROBBLE_COMPLETION_THRESHOLD=85
# SCROBBLE_DEDUP_WINDOW_HOURS=6
# SCROBBLE_DELIVERY_RETENTION_DAYS=30
# Requests a minute one API token (or address) may send, and reports a minute
# one integration's webhook address may receive.
# API_RATE_LIMIT_PER_MINUTE=240
# WEBHOOK_RATE_LIMIT_PER_MINUTE=60

# TMDB
TMDB_API_KEY=

# IGDB — games (Twitch developer credentials, https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Hardcover — books (https://hardcover.app/account/api)
HARDCOVER_API_KEY=

# MyAnimeList — manga (https://myanimelist.net/apiconfig)
MAL_CLIENT_ID=

# Simkl — import through a connected account. Register an AUTH V2 app of type
# "TV, devices & command line" at https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=

# Steam — import a public game library (https://steamcommunity.com/dev/apikey).
# Needs IGDB above to place the games.
STEAM_API_KEY=

# Apprise — notification channels to many services, through an apprise-api
# container (https://github.com/caronc/apprise-api), e.g. http://apprise:8000
APPRISE_API_URL=

# ComicVine — comics (https://comicvine.gamespot.com/api)
COMICVINE_API_KEY=
