{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
    "schedule": ["before 6am on monday"],
    "timezone": "UTC",
    "minimumReleaseAge": "3 days",
    "semanticCommits": "enabled",
    "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on the first day of the month"] },
    "vulnerabilityAlerts": { "enabled": true, "schedule": ["at any time"], "minimumReleaseAge": null },
    "packageRules": [
        { "groupName": "Laravel", "matchPackageNames": ["laravel/**", "inertiajs/**"] },
        { "groupName": "Vue and Inertia", "matchPackageNames": ["vue", "vue-tsc", "@vue/**", "@inertiajs/**", "@vitejs/**", "vite"] },
        { "groupName": "Quality tools", "matchPackageNames": ["phpstan/**", "larastan/**", "laravel/pint", "pestphp/**", "eslint", "eslint-*", "@eslint/**", "typescript-eslint", "prettier", "prettier-*", "vitest", "@vitest/**"] },
        { "groupName": "GitHub Actions", "matchManagers": ["github-actions"] },
        { "groupName": "Base images", "matchManagers": ["dockerfile"] },
        { "matchDepTypes": ["devDependencies", "require-dev"], "matchUpdateTypes": ["patch", "minor"], "automerge": true },
        { "matchManagers": ["github-actions"], "matchUpdateTypes": ["digest", "pinDigest", "patch", "minor"], "automerge": true }
    ]
}
