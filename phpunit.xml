<?xml version="1.0" encoding="UTF-8"?>
<!-- Any deprecation fails the run, whoever raises it: ours is fixed at once,
     a package's means the package is due an update. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnPhpunitDeprecations="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="2G"/>
        <ini name="error_reporting" value="-1"/>
        <env name="APP_ENV" value="testing"/>
        <!-- Pinned rather than read from the developer's .env: encryption,
             the clock's zone and the language of every text a test reads. -->
        <env name="APP_KEY" value="base64:dGVzdGluZy1rZXktb2YtdGhlLXRlc3Qtc3VpdGUtMzI="/>
        <env name="APP_TIMEZONE" value="UTC"/>
        <env name="DEFAULT_LOCALE" value="en"/>
        <env name="REGISTRATION_ENABLED" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TMDB_API_KEY" value="testing-key"/>
        <!-- Explicitly empty: the games, books, manga and comics modules,
             the Simkl connection and the identity providers stay off unless
             a test enables them via config(), regardless of the developer's
             .env; so do the sign-in switches. -->
        <env name="IGDB_CLIENT_ID" value=""/>
        <env name="IGDB_CLIENT_SECRET" value=""/>
        <env name="HARDCOVER_API_KEY" value=""/>
        <env name="MAL_CLIENT_ID" value=""/>
        <env name="COMICVINE_API_KEY" value=""/>
        <env name="MDBLIST_CLIENT_ID" value=""/>
        <env name="SIMKL_CLIENT_ID" value=""/>
        <env name="STEAM_API_KEY" value=""/>
        <!-- Forced, in both places PHP keeps it: the development stack sets
             it as a process variable, which a plain <env> would not replace. -->
        <env name="APPRISE_API_URL" value="" force="true"/>
        <server name="APPRISE_API_URL" value="" force="true"/>
        <!-- No key pair unless a test gives one: the development instance keeps its own in storage. -->
        <env name="VAPID_PUBLIC_KEY" value="" force="true"/>
        <env name="VAPID_PRIVATE_KEY" value="" force="true"/>
        <env name="VAPID_KEYS_PATH" value="/nonexistent/vapid.json" force="true"/>
        <env name="OIDC_CLIENT_ID" value=""/>
        <env name="GOOGLE_CLIENT_ID" value=""/>
        <env name="GITHUB_CLIENT_ID" value=""/>
        <env name="GITLAB_CLIENT_ID" value=""/>
        <env name="PASSWORD_LOGIN_ENABLED" value="true"/>
    </php>
</phpunit>
