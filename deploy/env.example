# VideTrack settings. Copy to `.env` next to compose.yaml and fill in.

# --- Required ---------------------------------------------------------------

# Shows and movies come from TMDB: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# The address people open the instance at. Links in e-mails and Discord
# messages are built from it, and https:// keeps the session cookie on HTTPS.
APP_URL=http://localhost:8080

# --- Optional ---------------------------------------------------------------

# Which release to run. Unset follows `latest`, the newest release; pin a line
# ("0.1": its patches only) or one version ("0.1.0") to upgrade when you
# decide. See docs/upgrading.md.
# VIDETRACK_VERSION=0.1

# The first account registered becomes the administrator, and sign-up closes
# after it. Set true to keep sign-up open, false to keep it closed. Instead of
# registering, the administrator can be created on start:
# REGISTRATION_ENABLED=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Sign in through your own OpenID Connect server (Keycloak, Authelia,
# Authentik, Pocket ID…), Google, GitHub or GitLab: each provider set here shows
# on the login page. Give the provider the callback
# <APP_URL>/auth/<oidc|google|github|gitlab>/callback. See docs/install.md for
# who gets an account and for turning passwords off.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_URL=https://gitlab.com
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# Language for new accounts (en, pl) and the instance's time zone.
# DEFAULT_LOCALE=en
# APP_TIMEZONE=UTC

# Media types beyond shows and movies: each needs its own key.
# Games: Twitch developer credentials, https://dev.twitch.tv/console/apps
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# Books: https://hardcover.app/account/api
# HARDCOVER_API_KEY=
# Anime and manga: https://myanimelist.net/apiconfig
# MAL_CLIENT_ID=
# Comics: https://comicvine.gamespot.com/api/
# COMICVINE_API_KEY=

# Imports that need a key of their own.
# SIMKL_CLIENT_ID=
# STEAM_API_KEY=

# Mail sends password-reset links. Without it the link is written to the
# container log (docker compose logs).
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=

# Private-network hosts an ordinary account may connect an integration to
# (an administrator may use any address), comma-separated.
# INTEGRATION_PRIVATE_HOSTS=tracearr.lan,192.168.1.20

# Whose X-Forwarded-* headers to believe. The default trusts proxies on
# private addresses; list a proxy on a public address here.
# TRUSTED_PROXIES=PRIVATE_SUBNETS

# The app key encrypts stored tokens and sessions. Generated on first start
# and kept in the data volume; set it only to bring your own.
# APP_KEY=
