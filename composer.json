{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "maxrzepkowski/videtrack",
    "type": "project",
    "description": "Self-hosted tracker for shows, movies, anime, games, books, manga and comics.",
    "keywords": [
        "media-tracker",
        "self-hosted",
        "tv",
        "movies",
        "games",
        "books"
    ],
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/MaxRzepkowski/VideTrack",
    "require": {
        "php": "^8.5",
        "dedoc/scramble": "^0.13.45",
        "inertiajs/inertia-laravel": "^3.7",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10.1",
        "spatie/icalendar-generator": "^3.3",
        "tightenco/ziggy": "^2.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "sh scripts/check.sh"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
